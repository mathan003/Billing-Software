            "description": "Checks server online status, server time, and application version."
          },
          "response": []
        },
        {
          "name": "OpenAPI 3.0 Schema",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
