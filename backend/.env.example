# Django Settings
SECRET_KEY=change-this-in-production-to-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.onrender.com

# Database Settings
# Option A: MySQL Connection (Default for local or Render MySQL)
DB_NAME=billing_db
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306

# Option B: Cloud Database URL (Overrides above when set)
# DATABASE_URL=mysql://root:password@hostname:3306/billing_db
# DATABASE_URL=postgres://user:password@hostname:5432/billing_db

# Fallback to SQLite if needed
# USE_SQLITE=False
